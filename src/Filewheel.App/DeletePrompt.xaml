<Window x:Class="Filewheel.App.DeletePrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eliminar"
        Width="380" Height="96"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        KeyDown="OnKeyDown">
    <Border x:Name="Root"
            Focusable="True"
            Background="#F2181A21"
            CornerRadius="10"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="14,11">
        <StackPanel>
            <TextBlock Text="Mover a la papelera"
                       Foreground="#8A93A6"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Margin="0,0,0,6" />
            <TextBlock x:Name="SubjectText"
                       Foreground="#F2F4F8"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="HintText"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Foreground="#8A93A6"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</Window>