<Window x:Class="Filewheel.App.RenamePrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renombrar"
        Width="380" Height="108"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Border Background="#F2181A21"
            CornerRadius="10"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="14,11">
        <StackPanel>
            <TextBlock x:Name="OriginalText"
                       Foreground="#8A93A6"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,6" />
            <TextBox x:Name="NameBox"
                     FontFamily="Segoe UI"
                     FontSize="13"
                     Foreground="#F2F4F8"
                     CaretBrush="#F2F4F8"
                     SelectionBrush="#2F6FE8"
                     Background="#2A2E3A"
                     BorderThickness="0"
                     Padding="7,5"
                     KeyDown="OnKeyDown" />
            <TextBlock x:Name="HintText"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Foreground="#8A93A6"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>
    </Border>
</Window>